/* =========================================
   PART 3 — GAMES, LETTER & GRAND FINALE
   ========================================= */

/* BADMINTON GAME */
.badminton-section,
.badminton-game {
  position: relative;
  overflow: hidden;
}

.badminton-court {
  position: relative;
  width: min(100%, 680px);
  min-height: 300px;
  margin: 28px auto;
  padding: 25px;
  border: 2px solid rgba(255, 253, 251, 0.85);
  border-radius: var(--radius-large);
  background: linear-gradient(145deg, #d8e9e8, #c5dce9);
  box-shadow: var(--shadow);
}

.badminton-net {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 50%;
  width: 3px;
  background: repeating-linear-gradient(
    to bottom,
    rgba(255,255,255,.9) 0 8px,
    rgba(114,86,75,.25) 8px 13px
  );
}

.badminton-court::before,
.badminton-court::after {
  content: "";
  position: absolute;
  left: 8%;
  right: 8%;
  height: 1px;
  background: rgba(255,255,255,.75);
}

.badminton-court::before { top: 20%; }
.badminton-court::after { bottom: 20%; }

.badminton-shuttle,
.shuttlecock {
  position: absolute;
  z-index: 2;
  top: 42%;
  left: 45%;
  font-size: 2.2rem;
  cursor: pointer;
  user-select: none;
  transition: transform .25s ease, left .25s ease, top .25s ease;
}

.badminton-shuttle:hover,
.shuttlecock:hover {
  transform: rotate(-20deg) scale(1.2);
}

.badminton-score,
.game-score {
  margin: 15px 0;
  color: var(--brown);
  font-weight: 700;
  text-align: center;
}

/* CAKE DECORATING STATION */
.cake-section,
.cake-game {
  position: relative;
}

.cake-station {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 22px;
  align-items: center;
  width: min(100%, 780px);
  margin: 28px auto;
  padding: clamp(18px, 4vw, 32px);
  border: 1px solid rgba(216,220,227,.9);
  border-radius: var(--radius-large);
  background: rgba(255,253,251,.82);
  box-shadow: var(--shadow);
}

.cake-display {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 250px;
  padding: 18px;
  border-radius: var(--radius-medium);
  background: linear-gradient(145deg, var(--pink-light), var(--blue-light));
}

.cake {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  width: 190px;
  height: 160px;
  margin: 20px auto;
}

.cake-top {
  z-index: 2;
  width: 150px;
  height: 42px;
  border: 2px solid rgba(114,86,75,.16);
  border-radius: 50%;
  background: #fff0f5;
}

.cake-layer {
  width: 170px;
  height: 55px;
  margin-top: -12px;
  border: 2px solid rgba(114,86,75,.13);
  border-radius: 12px 12px 22px 22px;
  background: #eab8cc;
}

.cake-layer:nth-of-type(3) {
  width: 190px;
  background: #c8deed;
}

.cake-candle {
  position: absolute;
  z-index: 3;
  top: -4px;
  width: 9px;
  height: 35px;
  border-radius: 5px;
  background: repeating-linear-gradient(
    135deg,
    #fff 0 5px,
    #d9a8bc 5px 10px
  );
}

.cake-flame {
  position: absolute;
  top: -20px;
  left: -3px;
  width: 14px;
  height: 18px;
  border-radius: 50% 50% 45% 45%;
  background: #ffd77a;
  box-shadow: 0 0 15px rgba(255,215,122,.8);
}

.cake-tools,
.cake-controls,
.decoration-options {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 10px;
  margin: 15px 0;
}

.cake-tools button,
.cake-controls button,
.decoration-options button,
.cake-decoration {
  padding: 10px 14px;
  border: 1px solid rgba(216,220,227,.9);
  border-radius: 999px;
  background: var(--white);
  color: var(--brown);
  font: inherit;
  cursor: pointer;
  transition: transform .2s ease, background .2s ease;
}

.cake-tools button:hover,
.cake-controls button:hover,
.decoration-options button:hover {
  transform: translateY(-2px);
  background: var(--pink-light);
}

.cake-message {
  min-height: 28px;
  margin-top: 12px;
  color: var(--brown);
  font-family: var(--font-heading);
  font-size: 1.2rem;
  text-align: center;
}

/* GROWING BIRTHDAY TREE */
.tree-garden,
#tree-garden {
  position: relative;
  width: min(100%, 720px);
  margin: 28px auto;
  padding: 28px 20px;
  overflow: hidden;
  border: 1px solid rgba(255,255,255,.8);
  border-radius: var(--radius-large);
  background: linear-gradient(180deg, #e5f0f5, #f8e8ee);
  box-shadow: var(--shadow);
  text-align: center;
}

.tree-scene {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  min-height: 250px;
}

#birthday-tree {
  position: relative;
  font-size: clamp(5rem, 18vw, 9rem);
  line-height: 1.2;
  transform-origin: bottom center;
  transition: transform .6s ease, filter .6s ease;
}

#birthday-tree.tree-grown {
  transform: scale(1.15);
  filter: drop-shadow(0 8px 12px rgba(114,86,75,.15));
}

#birthday-tree.tree-blooming {
  filter: drop-shadow(0 0 16px rgba(237,203,216,.9));
}

.tree-controls,
.tree-buttons {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 10px;
  margin: 18px auto;
}

.tree-controls button,
.tree-buttons button,
#water-tree,
#feed-tree,
#flower-tree {
  padding: 11px 18px;
  border: 0;
  border-radius: 999px;
  background: var(--white);
  color: var(--brown);
  font: inherit;
  cursor: pointer;
  box-shadow: var(--shadow-soft);
  transition: transform .2s ease, background .2s ease;
}

.tree-controls button:hover,
.tree-buttons button:hover,
#water-tree:hover,
#feed-tree:hover,
#flower-tree:hover {
  transform: translateY(-2px);
  background: var(--pink-light);
}

.tree-message,
#tree-message {
  min-height: 25px;
  margin-top: 12px;
  color: var(--brown);
}

/* CONSTELLATION PUZZLE */
#constellation-game,
.constellation-game {
  width: min(100%, 700px);
  margin: 28px auto;
  padding: clamp(18px, 4vw, 30px);
  border: 1px solid rgba(216,220,227,.9);
  border-radius: var(--radius-large);
  background:
    radial-gradient(circle at 20% 20%, rgba(255,255,255,.9), transparent 25%),
    linear-gradient(145deg, #e5eef8, #f8e8ee);
  box-shadow: var(--shadow);
  text-align: center;
}

.constellation-sky {
  position: relative;
  width: 100%;
  min-height: 260px;
  margin: 18px auto;
  overflow: hidden;
  border-radius: var(--radius-medium);
  background: linear-gradient(160deg, #b6c9e2, #d8c8df);
}

#constellation-game svg {
  display: block;
  width: 100%;
  min-height: 250px;
  overflow: visible;
}

.constellation-line {
  fill: none;
  stroke: rgba(255,253,251,.85);
  stroke-width: 2;
  stroke-linecap: round;
  stroke-dasharray: 5 7;
  opacity: .4;
  transition: opacity .3s ease, stroke .3s ease;
}

.constellation-line.connected {
  stroke: #fffdfb;
  stroke-dasharray: none;
  opacity: 1;
}

.constellation-star {
  fill: #fff4c9;
  stroke: #fffdfb;
  stroke-width: 2;
  cursor: pointer;
  filter: drop-shadow(0 0 5px rgba(255,255,255,.8));
  transition: transform .2s ease, fill .2s ease;
  transform-box: fill-box;
  transform-origin: center;
}

.constellation-star:hover {
  transform: scale(1.35);
}

.constellation-star.connected {
  fill: #edcbd8;
}

#constellation-message {
  min-height: 28px;
  margin: 15px 0;
  color: var(--brown);
  font-family: var(--font-heading);
  font-size: 1.2rem;
}

#reset-constellation {
  margin-top: 10px;
}

/* COLLECTED STARS */
#star-collection,
.star-collection {
  width: min(100%, 700px);
  margin: 28px auto;
  padding: 25px;
  border: 1px solid rgba(216,220,227,.8);
  border-radius: var(--radius-large);
  background: rgba(255,253,251,.86);
  box-shadow: var(--shadow-soft);
  text-align: center;
}

.collection-stars {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 15px;
  margin: 22px auto;
}

.collection-star,
#star-collection .collection-star {
  display: inline-block;
  color: #c7cbd3;
  font-size: 2rem;
  transition: transform .35s ease, color .35s ease, filter .35s ease;
}

.collection-star.collected,
#star-collection .collection-star.collected {
  color: #e4bd69;
  filter: drop-shadow(0 0 7px rgba(228,189,105,.55));
  transform: scale(1.15);
}

#collected-star-count {
  color: var(--brown);
  font-weight: 700;
}

#collection-message {
  min-height: 25px;
  color: var(--brown);
}

/* SECRET LETTER */
#birthday-letter,
.birthday-letter {
  position: relative;
  padding: clamp(40px, 8vw, 85px) 18px;
  text-align: center;
}

#open-letter {
  margin: 20px auto;
}

#letter-paper {
  width: min(100%, 620px);
  margin: 25px auto;
  padding: clamp(25px, 6vw, 50px);
  border: 1px solid rgba(216,220,227,.95);
  border-radius: 5px 5px 22px 5px;
  background:
    linear-gradient(rgba(255,253,251,.94), rgba(255,253,251,.94)),
    repeating-linear-gradient(
      transparent 0 31px,
      rgba(143,174,197,.2) 31px 32px
    );
  box-shadow: 0 16px 45px rgba(69,51,46,.12);
  color: var(--text);
  text-align: left;
  animation: letterReveal .8s ease both;
}

#letter-paper[hidden] {
  display: none;
}

#letter-paper h3 {
  margin-bottom: 20px;
  color: var(--brown);
  font-family: var(--font-heading);
  font-size: clamp(1.7rem, 5vw, 2.4rem);
  font-weight: 600;
}

#letter-paper p {
  margin: 13px 0;
  font-size: .94rem;
  line-height: 1.9;
}

#letter-paper .secret-line {
  margin-top: 25px;
  color: #b66f91;
  font-size: 1rem;
  font-weight: 700;
  font-style: italic;
}

@keyframes letterReveal {
  from {
    opacity: 0;
    transform: translateY(18px) rotate(-1deg);
  }
  to {
    opacity: 1;
    transform: translateY(0) rotate(0);
  }
}

/* GRAND FINALE */
#grand-finale,
.grand-finale {
  position: relative;
  padding: clamp(65px, 12vw, 120px) 20px;
  overflow: hidden;
  border-radius: var(--radius-large);
  background:
    radial-gradient(circle at 15% 20%, rgba(255,255,255,.85), transparent 20%),
    radial-gradient(circle at 85% 75%, rgba(255,255,255,.65), transparent 24%),
    linear-gradient(135deg, #f4dce6, #dcebf4 55%, #eee3d9);
  text-align: center;
}

#grand-finale h2,
.grand-finale h2 {
  margin: 15px auto;
  color: var(--brown-dark);
  font-family: var(--font-heading);
  font-size: clamp(2.5rem, 8vw, 5rem);
  font-weight: 500;
  line-height: 1.05;
}

#grand-finale p,
.grand-finale p {
  max-width: 560px;
  margin: 12px auto;
  color: var(--text);
  line-height: 1.8;
}

#grand-finale .final-date,
.final-date {
  margin-top: 28px;
  color: var(--brown-light);
  font-size: .9rem;
  letter-spacing: .16em;
}

.site-footer,
footer {
  padding: 25px 16px;
  color: var(--text-light);
  font-size: .8rem;
  text-align: center;
}

/* PHOTO IMAGES */
.photo-card img,
.photo-gallery img,
.memory-photo {
  display: block;
  width: 100%;
  height: 100%;
  min-height: 190px;
  object-fit: cover;
  border-radius: inherit;
}

.photo-card img {
  transition: transform .5s ease;
}

.photo-card:hover img {
  transform: scale(1.035);
}

/* SMALL SCREEN ADJUSTMENTS */
@media (max-width: 600px) {
  .cake-station {
    grid-template-columns: 1fr;
  }

  .cake-display {
    min-height: 220px;
