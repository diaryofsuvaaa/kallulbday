/* ==========================================
   KALLUL-23
   A Little Universe, Just for You
   SECTION 1: FOUNDATION & GLOBAL DESIGN
========================================== */

/* ---------- COLOUR PALETTE ---------- */

:root {
  --pink: #edcbd8;
  --pink-light: #f8e8ee;
  --pink-deep: #d9a8bc;

  --blue: #c7ddeb;
  --blue-light: #e7f1f7;
  --blue-deep: #8faec5;

  --brown: #72564b;
  --brown-dark: #45332e;
  --brown-light: #a78a79;

  --silver: #d8dce3;
  --silver-light: #f0f1f4;

  --cream: #faf6ef;
  --cream-dark: #eee5d9;
  --white: #fffdfb;

  --text: #5b4944;
  --text-light: #89736a;

  --shadow: 0 12px 36px rgba(69, 51, 46, 0.10);
  --shadow-soft: 0 5px 20px rgba(69, 51, 46, 0.07);

  --radius-small: 12px;
  --radius-medium: 20px;
  --radius-large: 30px;

  --font-heading: "Cormorant Garamond", Georgia, serif;
  --font-body: "DM Sans", sans-serif;
  --font-script: "Parisienne", cursive;
}


/* ---------- RESET ---------- */

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 30px;
}

body {
  margin: 0;
  min-width: 320px;
  color: var(--text);
  background: var(--cream);
  font-family: var(--font-body);
  font-size: 14px;
  line-height: 1.8;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
}

body,
button,
input {
  font-family: var(--font-body);
}

button,
input {
  font-size: inherit;
}

button {
  -webkit-tap-highlight-color: transparent;
}

button:focus-visible,
input:focus-visible {
  outline: 2px solid var(--blue-deep);
  outline-offset: 4px;
}

button:disabled {
  cursor: not-allowed;
  opacity: 0.5;
}

img {
  display: block;
  max-width: 100%;
}

figure {
  margin: 0;
}

h1,
h2,
h3,
h4,
p {
  margin-top: 0;
}

h1,
h2,
h3,
h4 {
  font-family: var(--font-heading);
  font-weight: 500;
  line-height: 1.2;
}

h2 em,
h3 em {
  color: var(--brown-light);
  font-weight: 500;
}

[hidden] {
  display: none !important;
}


/* ---------- MAIN BACKGROUND ---------- */

#universe-background {
  position: relative;
  isolation: isolate;
  overflow: hidden;
  background:
    radial-gradient(
      ellipse at 10% 15%,
      rgba(237, 203, 216, 0.24),
      transparent 32%
    ),
    radial-gradient(
      ellipse at 90% 35%,
      rgba(199, 221, 235, 0.35),
      transparent 35%
    ),
    var(--cream);
}

.content-section {
  position: relative;
  z-index: 1;
  width: 100%;
  padding: 100px 24px;
}

.content-section > * {
  max-width: 100%;
}

.section-heading {
  max-width: 700px;
  margin: 0 auto 48px;
  text-align: center;
}

.eyebrow {
  margin-bottom: 14px;
  color: var(--brown-light);
  font-family: var(--font-body);
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 3px;
  line-height: 1.8;
  text-transform: uppercase;
}

.section-heading h2 {
  margin-bottom: 18px;
  color: var(--brown-dark);
  font-size: clamp(34px, 5vw, 52px);
  letter-spacing: -0.7px;
}

.section-description {
  max-width: 530px;
  margin: 0 auto;
  color: var(--text-light);
  font-size: 13px;
  line-height: 2;
}


/* ---------- DIVIDERS ---------- */

.welcome-divider {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 16px;
  margin: 28px 0;
  color: var(--silver);
  font-size: 15px;
}

.welcome-divider span:nth-child(2) {
  color: var(--pink-deep);
  font-size: 20px;
}


/* ---------- BUTTONS ---------- */

.primary-button,
.secondary-button {
  display: inline-flex;
  justify-content: center;
  align-items: center;
  gap: 9px;
  min-height: 46px;
  padding: 12px 23px;
  border: 1px solid transparent;
  border-radius: 999px;
  cursor: pointer;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.4px;
  text-align: center;
  text-decoration: none;
  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease,
    background 0.25s ease;
}

.primary-button {
  color: var(--brown-dark);
  background: linear-gradient(
    120deg,
    var(--pink-light),
    var(--blue-light)
  );
  border-color: rgba(255, 255, 255, 0.75);
  box-shadow: 0 7px 20px rgba(114, 86, 75, 0.10);
}

.secondary-button {
  color: var(--brown);
  background: rgba(255, 253, 251, 0.8);
  border-color: rgba(167, 138, 121, 0.25);
}

@media (hover: hover) {
  .primary-button:hover,
  .secondary-button:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
  }
}

.primary-button:active,
.secondary-button:active {
  transform: scale(0.98);
}


/* ---------- FLOATING MUSIC CONTROL ---------- */

.music-control {
  position: fixed;
  top: 18px;
  right: 18px;
  z-index: 100;
}

.music-button {
  min-height: 38px;
  padding: 9px 15px;
  color: var(--brown-dark);
  background: rgba(250, 246, 239, 0.91);
  border: 1px solid rgba(216, 220, 227, 0.85);
  border-radius: 999px;
  box-shadow: var(--shadow-soft);
  cursor: pointer;
  font-size: 10px;
  backdrop-filter: blur(12px);
}


/* ---------- JOURNEY PROGRESS ---------- */

.journey-progress {
  position: fixed;
  top: 20px;
  left: 18px;
  z-index: 100;
  padding: 9px 13px;
  color: var(--brown-dark);
  background: rgba(250, 246, 239, 0.91);
  border: 1px solid rgba(216, 220, 227, 0.85);
  border-radius: 999px;
  box-shadow: var(--shadow-soft);
  font-size: 9px;
  backdrop-filter: blur(12px);
}

#star-count {
  color: var(--brown);
  font-weight: 700;
}


/* ---------- FIRELFY BACKGROUND ---------- */

.firefly-background {
  position: fixed;
  inset: 0;
  z-index: 50;
  overflow: hidden;
  pointer-events: none;
}

.floating-firefly {
  position: absolute;
  width: 4px;
  height: 4px;
  background: #fff4cf;
  border-radius: 50%;
  box-shadow:
    0 0 5px 2px rgba(255, 239, 190, 0.6),
    0 0 14px 4px rgba(237, 203, 216, 0.25);
  opacity: 0;
  animation: firefly-drift 8s ease-in-out infinite;
}

@keyframes firefly-drift {
  0% {
    opacity: 0;
    transform: translate3d(0, 15px, 0);
  }

  20% {
    opacity: 0.8;
  }

  50% {
    opacity: 0.45;
    transform: translate3d(22px, -35px, 0);
  }

  80% {
    opacity: 0.9;
  }

  100% {
    opacity: 0;
    transform: translate3d(-12px, -70px, 0);
  }
}


/* ---------- SECTION SEPARATORS ---------- */

.content-section::after {
  content: "✧  ♡  ✧";
  position: absolute;
  bottom: 20px;
  left: 50%;
  color: rgba(167, 138, 121, 0.55);
  font-size: 12px;
  letter-spacing: 7px;
  white-space: nowrap;
  transform: translateX(-50%);
  pointer-events: none;
}


/* ---------- REDUCED MOTION ---------- */

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}
/* ==========================================
   KALLUL-23
   CSS PART 2: WELCOME, FOREST & FIRST GAMES
========================================== */


/* ==========================================
   1. WELCOME SCREEN
========================================== */

.welcome-section {
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100svh;
  min-height: 100vh;
  padding: 100px 24px 80px;
  overflow: hidden;
  isolation: isolate;

  background:
    linear-gradient(
      180deg,
      rgba(27, 39, 48, 0.16) 0%,
      rgba(35, 39, 43, 0.30) 45%,
      rgba(42, 35, 34, 0.76) 100%
    ),
    url("https://images.unsplash.com/photo-1448375240586-882707db888b?auto=format&fit=crop&w=2000&q=85")
    center 55% / cover no-repeat,
    linear-gradient(135deg, #b9cddd, #d8c0ca, #6b756c);
}

.welcome-overlay {
  position: absolute;
  inset: 0;
  z-index: -1;

  background:
    radial-gradient(
      ellipse at 50% 35%,
      rgba(231, 218, 226, 0.12),
      transparent 55%
    ),
    linear-gradient(
      0deg,
      rgba(42, 35, 34, 0.38),
      transparent 70%
    );
}

.welcome-content {
  position: relative;
  z-index: 2;
  width: min(100%, 620px);
  padding: 48px 25px;
  text-align: center;
  color: #fffaf6;
  animation: welcome-arrive 1.3s ease both;
}

@keyframes welcome-arrive {
  from {
    opacity: 0;
    transform: translateY(18px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.welcome-content .eyebrow {
  color: #f4e3e8;
  font-size: 9px;
  letter-spacing: 3.5px;
}

.welcome-content h1 {
  margin: 22px 0 12px;
  color: #fffaf6;
  font-size: clamp(55px, 13vw, 100px);
  font-weight: 500;
  letter-spacing: 7px;
  line-height: 1;
  text-shadow: 0 5px 28px rgba(25, 30, 32, 0.20);
}

.title-number {
  display: inline-block;
  color: #e8d5df;
  font-size: 0.7em;
  font-weight: 400;
  letter-spacing: 1px;
}

.welcome-subtitle {
  margin: 20px 0 0;
  color: #fff5f4;
  font-family: var(--font-heading);
  font-size: clamp(22px, 5vw, 31px);
  font-style: italic;
  font-weight: 400;
}

.welcome-description {
  margin: 0;
  color: rgba(255, 250, 246, 0.92);
  font-family: var(--font-heading);
  font-size: clamp(17px, 3.5vw, 21px);
  line-height: 1.9;
}

.date-caption {
  margin: 25px 0 30px;
  color: #f2dfe5;
  font-size: 10px;
  letter-spacing: 2px;
}

.welcome-footnote {
  margin: 22px 0 0;
  color: rgba(255, 250, 246, 0.80);
  font-family: var(--font-heading);
  font-size: 15px;
  font-style: italic;
}

.welcome-content .primary-button {
  color: #44332f;
  background: linear-gradient(120deg, #f7e6ec, #dceaf4);
}

.scroll-indicator {
  position: absolute;
  bottom: 24px;
  left: 50%;
  color: #f6e8eb;
  font-size: 23px;
  animation: scroll-bob 2s ease-in-out infinite;
}

@keyframes scroll-bob {
  0%, 100% {
    transform: translate(-50%, 0);
  }

  50% {
    transform: translate(-50%, 7px);
  }
}


/* ==========================================
   2. OUR STORY & IMPORTANT DATES
========================================== */

.story-section {
  background:
    radial-gradient(
      ellipse at 10% 30%,
      rgba(237, 203, 216, 0.22),
      transparent 38%
    ),
    var(--cream);
}

.date-cards {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 38px minmax(0, 1fr);
  align-items: stretch;
  gap: 15px;
  max-width: 850px;
  margin: 0 auto 60px;
}

.date-card {
  padding: 32px 24px;
  border: 1px solid rgba(255, 255, 255, 0.8);
  border-radius: var(--radius-medium);
  text-align: center;
  box-shadow: var(--shadow-soft);
}

.birthday-date {
  background: linear-gradient(145deg, #f8e8ee, #f4e7df);
}

.anniversary-date {
  background: linear-gradient(145deg, #e7f1f7, #f3edf3);
}

.date-icon {
  display: inline-block;
  margin-bottom: 13px;
  color: var(--brown-light);
  font-size: 28px;
}

.date-label {
  margin-bottom: 10px;
  color: var(--text-light);
  font-size: 10px;
  letter-spacing: 1px;
}

.date-card h3 {
  margin-bottom: 14px;
  color: var(--brown-dark);
  font-size: clamp(20px, 3vw, 27px);
}

.date-card > p:last-child {
  margin-bottom: 0;
  font-size: 12px;
  line-height: 1.9;
}

.date-connector {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--pink-deep);
  font-size: 24px;
}

.story-quote {
  max-width: 650px;
  margin: 0 auto;
  padding: 28px 30px;
  border-left: 2px solid var(--pink-deep);
  background: rgba(255, 253, 251, 0.64);
  border-radius: 0 var(--radius-medium) var(--radius-medium) 0;
  text-align: left;
}

.quote-mark {
  display: block;
  height: 25px;
  color: var(--pink-deep);
  font-family: var(--font-heading);
  font-size: 45px;
  line-height: 1;
}

.story-quote p {
  margin: 15px 0;
  color: var(--brown);
  font-family: var(--font-heading);
  font-size: clamp(19px, 4vw, 25px);
  font-style: italic;
  line-height: 1.6;
}

.quote-signature {
  color: var(--text-light);
  font-size: 10px;
  letter-spacing: 0.5px;
}


/* ==========================================
   3. PHOTO GALLERY
========================================== */

.memories-section {
  background:
    radial-gradient(
      ellipse at 85% 20%,
      rgba(199, 221, 235, 0.35),
      transparent 40%
    ),
    #f7f1eb;
}

.photo-gallery {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 22px;
  max-width: 850px;
  margin: 0 auto;
}

.photo-card {
  padding: 10px 10px 16px;
  background: var(--white);
  border: 1px solid rgba(216, 220, 227, 0.75);
  border-radius: 5px;
  box-shadow: 0 8px 24px rgba(69, 51, 46, 0.08);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.photo-card:first-child {
  transform: rotate(-1.5deg);
}

.photo-card:nth-child(2) {
  transform: rotate(1.5deg);
}

.photo-card:nth-child(3) {
  transform: rotate(-0.5deg);
}

@media (hover: hover) {
  .photo-card:hover {
    z-index: 2;
    transform: translateY(-5px) rotate(0);
    box-shadow: var(--shadow);
  }
}

.photo-placeholder {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  min-height: 190px;
  padding: 20px;
  color: var(--brown-light);
  background:
    linear-gradient(
      145deg,
      rgba(248, 232, 238, 0.88),
      rgba(231, 241, 247, 0.92)
    );
  text-align: center;
}

.photo-tall .photo-placeholder {
  min-height: 280px;
}

.photo-placeholder span {
  margin-bottom: 10px;
  color: var(--pink-deep);
  font-size: 29px;
}

.photo-placeholder p {
  margin-bottom: 0;
  font-family: var(--font-heading);
  font-size: 17px;
  font-style: italic;
}

.photo-card figcaption {
  padding: 13px 5px 0;
  color: var(--text-light);
  font-family: var(--font-heading);
  font-size: 15px;
  font-style: italic;
  line-height: 1.5;
  text-align: center;
}

.gallery-note {
  margin: 35px 0 0;
  color: var(--brown-light);
  font-family: var(--font-heading);
  font-size: 17px;
  font-style: italic;
  text-align: center;
}


/* ==========================================
   4. ENCHANTED FOREST
========================================== */

.forest-section {
  background:
    linear-gradient(
      180deg,
      #e9edf0 0%,
      #e5e7e4 22%,
      #d8d9d1 55%,
      #d1d8d3 100%
    );
}

.forest-heading {
  max-width: 700px;
  margin: 0 auto 40px;
  text-align: center;
}

.forest-heading h2 {
  margin-bottom: 18px;
  color: var(--brown-dark);
  font-size: clamp(35px, 6vw, 54px);
}

.forest-scene {
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 430px;
  max-width: 1000px;
  margin: 0 auto 70px;
  padding: 35px 20px;
  overflow: hidden;
  isolation: isolate;
  border: 1px solid rgba(255, 255, 255, 0.5);
  border-radius: var(--radius-large);

  background:
    linear-gradient(
      180deg,
      rgba(44, 57, 60, 0.13),
      rgba(36, 47, 43, 0.48)
    ),
    url("https://images.unsplash.com/photo-1448375240586-882707db888b?auto=format&fit=crop&w=1600&q=85")
    center / cover no-repeat,
    #67796e;

  box-shadow: var(--shadow);
}

.forest-atmosphere {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.forest-moon {
  position: absolute;
  top: 25px;
  right: 35px;
  color: #f8e8ee;
  font-size: 60px;
  opacity: 0.9;
  text-shadow: 0 0 35px rgba(248, 232, 238, 0.7);
}

.forest-star {
  position: absolute;
  color: #f8e8ee;
  text-shadow: 0 0 15px rgba(248, 232, 238, 0.9);
  animation: forest-twinkle 3s ease-in-out infinite;
}

.star-one {
  top: 17%;
  left: 18%;
}

.star-two {
  top: 35%;
  right: 18%;
  animation-delay: 1s;
}

.star-three {
  bottom: 23%;
  left: 14%;
  animation-delay: 1.5s;
}

@keyframes forest-twinkle {
  0%, 100% {
    opacity: 0.45;
    transform: scale(0.9);
  }

  50% {
    opacity: 1;
    transform: scale(1.2);
  }
}

.forest-intro {
  position: relative;
  z-index: 2;
  width: min(100%, 470px);
  padding: 35px 25px;
  color: #fffaf6;
  border: 1px solid rgba(255, 255, 255, 0.32);
  border-radius: var(--radius-medium);
  background: rgba(45, 52, 48, 0.42);
  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
  text-align: center;
  backdrop-filter: blur(7px);
}

.forest-small-title {
  color: #f0dfe5;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 2px;
}

.forest-intro p {
  margin: 20px 0 25px;
  font-family: var(--font-heading);
  font-size: 23px;
  line-height: 1.6;
}

.forest-intro .primary-button {
  color: var(--brown-dark);
  background: linear-gradient(120deg, #f8e8ee, #e7f1f7);
}

.forest-waterfall {
  position: absolute;
  bottom: 0;
  left: 8%;
  display: flex;
  gap: 4px;
  width: 22%;
  height: 35%;
  opacity: 0.45;
  pointer-events: none;
}

.waterfall-stream {
  flex: 1;
  border-radius: 50% 50% 0 0;
  background: linear-gradient(
    180deg,
    rgba(231, 241, 247, 0.0),
    rgba(199, 221, 235, 0.75),
    rgba(231, 241, 247, 0.15)
  );
  filter: blur(3px);
}


/* ==========================================
   5. SHARED GAME CARDS
========================================== */

.game-card {
  max-width: 800px;
  margin: 0 auto 55px;
  padding: 30px;
  border: 1px solid rgba(255, 255, 255, 0.9);
  border-radius: var(--radius-large);
  background: rgba(255, 253, 251, 0.78);
  box-shadow: var(--shadow-soft);
}

.game-heading {
  display: flex;
  align-items: center;
  gap: 16px;
  margin-bottom: 20px;
}

.game-number {
  display: flex;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
  width: 42px;
  height: 42px;
  color: var(--brown);
  border: 1px solid rgba(167, 138, 121, 0.25);
  border-radius: 50%;
  background: linear-gradient(145deg, var(--pink-light), var(--blue-light));
  font-family: var(--font-heading);
  font-size: 19px;
}

.game-heading .eyebrow {
  margin-bottom: 5px;
  font-size: 8px;
  letter-spacing: 1.6px;
}

.game-heading h3 {
  margin: 0;
  color: var(--brown-dark);
  font-size: clamp(24px, 4vw, 32px);
}

.game-description {
  margin-bottom: 25px;
  color: var(--text-light);
  font-size: 12px;
  line-height: 1.9;
}

.game-status {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-items: center;
  gap: 8px 20px;
  margin-top: 20px;
}

.game-status p {
  margin-bottom: 0;
  font-size: 11px;
}

.game-status strong {
  color: var(--brown);
}

.game-feedback {
  margin: 16px 0 0;
  color: var(--brown-light);
  font-family: var(--font-heading);
  font-size: 16px;
  font-style: italic;
  line-height: 1.7;
}


/* ==========================================
   6. FIREFLY GAME
========================================== */

.firefly-game {
  background:
    linear-gradient(
      145deg,
      rgba(231, 241, 247, 0.8),
      rgba(248, 232, 238, 0.65)
    );
}

.firefly-play-area {
  position: relative;
  min-height: 300px;
  overflow: hidden;
  border: 1px solid rgba(255, 255, 255, 0.45);
  border-radius: var(--radius-medium);

  background:
    radial-gradient(
      circle at 20% 85%,
      rgba(237, 203, 216, 0.22),
      transparent 30%
    ),
    radial-gradient(
      circle at 80% 20%,
      rgba(199, 221, 235, 0.14),
      transparent 35%
    ),
    linear-gradient(180deg, #414e4d, #344440 70%, #2e4038);
}

.firefly-play-area::before {
  content: "";
  position: absolute;
  right: -10%;
  bottom: -20%;
  left: -10%;
  height: 42%;
  border-radius: 50% 50% 0 0;
  background: linear-gradient(180deg, #5b6c5a, #35473b);
}

.firefly-decoration {
  position: absolute;
  z-index: 1;
  color: #dceaf4;
  opacity: 0.7;
}

.firefly-decoration-one {
  top: 20%;
  left: 20%;
}

.firefly-decoration-two {
  right: 18%;
  bottom: 24%;
}

.catch-firefly {
  position: absolute;
  z-index: 2;
  display: flex;
  justify-content: center;
  align-items: center;
  width: 42px;
  height: 42px;
  padding: 0;
  color: #fff0b8;
  border: 0;
  border-radius: 50%;
  background: transparent;
  font-size: 25px;
  cursor: pointer;
  text-shadow:
    0 0 6px #fff0b8,
    0 0 18px rgba(255, 231, 163, 0.9);
  animation: firefly-glow 2.5s ease-in-out infinite;
}

.catch-firefly:nth-of-type(2) {
  top: 20%;
  left: 17%;
}

.catch-firefly:nth-of-type(3) {
  top: 52%;
  left: 37%;
  animation-delay: 0.5s;
}

.catch-firefly:nth-of-type(4) {
  top: 28%;
  right: 24%;
  animation-delay: 1s;
}

.catch-firefly:nth-of-type(5) {
  right: 13%;
  bottom: 18%;
  animation-delay: 0.8s;
}

.catch-firefly:nth-of-type(6) {
  top: 65%;
  left: 14%;
  animation-delay: 1.3s;
}

.catch-firefly.caught {
  opacity: 0.18;
  pointer-events: none;
  animation: none;
  transform: scale(0.7);
}

@keyframes firefly-glow {
  0%, 100% {
    opacity: 0.65;
    transform: translateY(0) scale(0.9);
  }

  50% {
    opacity: 1;
    transform: translateY(-9px) scale(1.15);
  }
}


/* ==========================================
   7. HIDDEN MUSHROOM GAME
========================================== */

.mushroom-game {
  background:
    linear-gradient(
      145deg,
      rgba(248, 232, 238, 0.65),
      rgba(250, 246, 239, 0.95)
    );
}

.mushroom-play-area {
  position: relative;
  min-height: 290px;
  overflow: hidden;
  border: 1px solid rgba(167, 138, 121, 0.14);
  border-radius: var(--radius-medium);

  background:
    radial-gradient(
      ellipse at 50% 110%,
      #b7c3ad,
      transparent 55%
    ),
    linear-gradient(180deg, #e0e8e6, #d4dfd8);
}

.mushroom-play-area::before,
.mushroom-play-area::after {
  content: "";
  position: absolute;
  bottom: -35px;
  width: 75%;
  height: 105px;
  border-radius: 50%;
  background: #b6c3ac;
}

.mushroom-play-area::before {
  left: -20%;
}

.mushroom-play-area::after {
  right: -20%;
  background: #a9bba5;
}

.mushroom-scenery {
  position: absolute;
  z-index: 1;
  color: var(--brown-light);
  pointer-events: none;
}

.scenery-flower {
  top: 18%;
  left: 12%;
  font-size: 25px;
}

.scenery-leaf {
  right: 15%;
  bottom: 16%;
  font-size: 32px;
}

.scenery-star {
  top: 22%;
  right: 30%;
  color: #fffdfb;
  font-size: 17px;
}

.hidden-mushroom {
  position: absolute;
  z-index: 2;
  display: flex;
  justify-content: center;
  align-items: center;
  width: 42px;
  height: 42px;
  padding: 0;
  color: #fffdfb;
  border: 1px solid rgba(255, 255, 255, 0.7);
  border-radius: 50%;
  background: rgba(114, 86, 75, 0.2);
  cursor: pointer;
  font-size: 15px;
  transition:
    background 0.25s ease,
    transform 0.25s ease;
}

.hidden-mushroom:nth-of-type(4) {
  top: 20%;
  left: 28%;
}

.hidden-mushroom:nth-of-type(5) {
  top: 54%;
  left: 13%;
}

.hidden-mushroom:nth-of-type(6) {
  top: 32%;
  left: 57%;
}

.hidden-mushroom:nth-of-type(7) {
  right: 15%;
  bottom: 18%;
}

.hidden-mushroom:nth-of-type(8) {
  top: 68%;
  left: 42%;
}

@media (hover: hover) {
  .hidden-mushroom:hover {
    transform: scale(1.12);
    background: rgba(114, 86, 75, 0.55);
  }
}

.hidden-mushroom.found {
  color: var(--brown-dark);
  background: var(--pink-light);
  border-color: var(--pink-deep);
  font-size: 20px;
  transform: scale(1.08);
  pointer-events: none;
}


/* ==========================================
   8. RELATIONSHIP QUIZ
========================================== */

.relationship-quiz {
  background:
    linear-gradient(
      140deg,
      rgba(231, 241, 247, 0.75),
      rgba(248, 232, 238, 0.65)
    );
}

.quiz-paper {
  max-width: 580px;
  margin: 0 auto;
  padding: 30px;
  border: 1px solid rgba(255, 255, 255, 0.9);
  border-radius: var(--radius-medium);
  background: rgba(255, 253, 251, 0.92);
  box-shadow: var(--shadow-soft);
}

.quiz-progress {
  margin-bottom: 20px;
  color: var(--brown-light);
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 1.5px;
  text-transform: uppercase;
}

.quiz-question {
  margin-bottom: 25px;
  color: var(--brown-dark);
  font-family: var(--font-heading);
  font-size: clamp(22px, 4vw, 28px);
  font-weight: 600;
  line-height: 1.5;
}

.quiz-options {
  display: grid;
  gap: 12px;
}

.quiz-option {
  width: 100%;
  padding: 14px 16px;
  color: var(--text);
  border: 1px solid rgba(167, 138, 121, 0.22);
  border-radius: var(--radius-small);
  background: #fffdfb;
  cursor: pointer;
  font-size: 12px;
  text-align: left;
  transition:
    border-color 0.2s ease,
    background 0.2s ease,
    transform 0.2s ease;
}

@media (hover: hover) {
  .quiz-option:hover {
    transform: translateX(3px);
    border-color: var(--blue-deep);
    background: var(--blue-light);
  }
}

.quiz-option.correct {
  border-color: #a4c5aa;
  background: #e7f1e6;
}

.quiz-option.incorrect {
  border-color: #dfb3bf;
  background: #f8e8ee;
}

.quiz-option:disabled {
  opacity: 1;
  cursor: default;
}

.quiz-result {
  padding: 25px 0 0;
  text-align: center;
}

.quiz-result-heart {
  color: var(--pink-deep);
  font-size: 40px;
}

.quiz-result h4 {
  margin: 12px 0;
  color: var(--brown-dark);
  font-size: 24px;
}

.quiz-result p {
  color: var(--text-light);
  font-size: 12px;
  line-height: 1.9;
}

.quiz-result .secondary-button {
  margin-top: 10px;
}


/* ==========================================
   9. RESPONSIVE LAYOUT
